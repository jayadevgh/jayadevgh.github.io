---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfilePic from "../assets/images/profilepictures/376A3823.jpg";
import TransparentSeattle from "../assets/images/midnightseattle.png";
---

<BaseLayout title="Home">
  <div class="home-hero" style={`--hero-bg: url(${TransparentSeattle.src});`}>
    <section class="max-w-4xl mx-auto">
      <div class="flex items-center gap-6 mb-12">
        <img 
          src={ProfilePic.src}
          alt="Profile"
          class="w-32 h-32 rounded-full object-cover border-2 border-white/20 shadow-lg"
        />
        <div>
          <h1 class="text-5xl font-bold mb-2">Jayadev Ghanta</h1>
          <p class="text-lg text-white/70 leading-relaxed">
            Paul G. Allen School CS & Math double major (GPA 3.85/4.0) graduating June 2027.
            <br />
            I build research-grade systems that span multimodal ML, security, and music technology.
          </p>
          <div class="mt-4 flex gap-4 text-sm text-white/80 overflow-x-auto whitespace-nowrap pb-2">
            <a href="tel:+14084970954" class="hover:text-accent transition">(408) 497-0954</a>
            <span>•</span>
            <a href="mailto:jayadevgh@gmail.com" class="hover:text-accent transition">jayadevgh@gmail.com</a>
            <span>•</span>
            <a href="https://jayadevgh.github.io" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition">jayadevgh.github.io</a>
            <span>•</span>
            <a href="https://www.linkedin.com/in/jayadev-gh/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition">linkedin.com/in/jayadev-gh</a>
            <span>•</span>
            <a href="https://github.com/jayadevgh" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition">github.com/jayadevgh</a>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        <a href="/research" class="bg-surface p-6 rounded-xl border border-white/10 hover:border-accent transition">
          <h2 class="font-semibold text-xl mb-2">Research</h2>
          <p class="text-white/60 text-sm">Music-data pipelines, medical imaging work, and math research training.</p>
        </a>

        <a href="/projects" class="bg-surface p-6 rounded-xl border border-white/10 hover:border-accent transition">
          <h2 class="font-semibold text-xl mb-2">Projects</h2>
          <p class="text-white/60 text-sm">KeyGuard continuous auth, Bond BLE social matching, GPT-from-scratch, and DL microframeworks.</p>
        </a>

        <a href="/music" class="bg-surface p-6 rounded-xl border border-white/10 hover:border-accent transition">
          <h2 class="font-semibold text-xl mb-2">Music</h2>
          <p class="text-white/60 text-sm">Choir leadership, Kickkats, musicals, and the UCLA Summer Voice Intensive.</p>
        </a>

        <a href="/blogs" class="bg-surface p-6 rounded-xl border border-white/10 hover:border-accent transition">
          <h2 class="font-semibold text-xl mb-2">Blogs</h2>
          <p class="text-white/60 text-sm">Writing on BPE tokenizers, makemore, micrograd, and other ML notes.</p>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: 100vh;
  }

  .home-hero::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.9;
    z-index: -1;
  }
</style>
