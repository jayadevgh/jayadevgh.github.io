---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutProfile from "../assets/images/profilepictures/promphotoshoot.png";
import JayGoldenGate from "../assets/images/jaygoldengate.png";
import WFSuitFriends from "../assets/images/wfsuitwithfriends.png";
import SuitAura2 from "../assets/images/suitaura2.JPEG";
import AuraPic from "../assets/images/aurapic.JPEG";
import WaterPolo from "../assets/images/waterpolopic.png";
import CoastalHonorChoir from "../assets/images/coastalhonorchoir.JPEG";
import PromFriends from "../assets/images/promwfriends.png";
---

<BaseLayout title="About">
  <section class="max-w-4xl mx-auto">
    <div class="flex items-center gap-6 mb-6 flex-wrap">
      <img 
        src={AboutProfile.src}
        alt="Profile"
        class="w-24 h-24 rounded-full object-cover border-2 border-white/20 shadow-lg"
      />
      <div>
        <h1 class="text-4xl font-bold mb-2">About</h1>
        <p class="text-white/70 leading-relaxed">
          CS & Math double major at the Paul G. Allen School, University of Washington (GPA 3.85/4.0, graduating June 2027).
          I build data-heavy systems at the intersection of multimodal ML, research tooling, and music tech.
        </p>
      </div>
    </div>
    <div class="flex flex-wrap gap-4 text-sm text-white/80 mb-12">
      <a href="tel:+14084970954" class="bg-white/5 border border-white/10 px-4 py-2 rounded-full hover:border-accent transition">
        (408) 497-0954
      </a>
      <a href="mailto:jayadevgh@gmail.com" class="bg-white/5 border border-white/10 px-4 py-2 rounded-full hover:border-accent transition">
        jayadevgh@gmail.com
      </a>
      <a href="https://jayadevgh.github.io" target="_blank" rel="noopener noreferrer" class="bg-white/5 border border-white/10 px-4 py-2 rounded-full hover:border-accent transition">
        jayadevgh.github.io
      </a>
      <a href="https://www.linkedin.com/in/jayadev-gh/" target="_blank" rel="noopener noreferrer" class="bg-white/5 border border-white/10 px-4 py-2 rounded-full hover:border-accent transition">
        linkedin.com/in/jayadev-gh
      </a>
      <a href="https://github.com/jayadevgh" target="_blank" rel="noopener noreferrer" class="bg-white/5 border border-white/10 px-4 py-2 rounded-full hover:border-accent transition">
        github.com/jayadevgh
      </a>
    </div>

    <section class="space-y-10">
      <div>
        <h2 class="text-2xl font-semibold mb-3">Technical Skills</h2>
        <p class="text-white/70 mb-4">Snapshotted straight from my resume so each stack call-out tracks live work.</p>
        <div class="grid sm:grid-cols-2 gap-6 text-white/80 text-sm leading-relaxed">
          <div>
            <p class="text-white font-semibold mb-1">Languages</p>
            <p>Python, C, C++, Java, Kotlin, JavaScript, SQL, LaTeX, Bash, HTML, CSS</p>
          </div>
          <div>
            <p class="text-white font-semibold mb-1">Frameworks & Libraries</p>
            <p>PyTorch, NumPy, Pandas, Scikit-learn, Jetpack Compose, Firebase, AWS Bedrock, LangChain, Android BLE, Flask, React</p>
          </div>
          <div>
            <p class="text-white font-semibold mb-1 mt-2 sm:mt-0">Tools</p>
            <p>Git, GitHub, VS Code, Android Studio, Google Cloud Run, Codex, Docker, Jupyter, Vim, Linux</p>
          </div>
          <div>
            <p class="text-white font-semibold mb-1 mt-2 sm:mt-0">Topics</p>
            <p>Machine Learning, Deep Learning, NLP, Distributed Systems, Optimization, Cryptography, Statistics, Real Analysis</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-3">Coursework</h2>
        <div class="space-y-4 text-white/80 text-sm leading-relaxed">
          <div>
            <p class="text-white font-semibold mb-1">Completed</p>
            <p class="text-white/80">Data Structures & Algorithms, Systems Programming, Hardware/Software Interfaces, Real Analysis</p>
          </div>
          <div>
            <p class="text-white font-semibold mb-1">In Progress — Spring 2026</p>
            <p class="text-white/80">Algorithms, Reinforcement Learning, Deep Learning, Distributed Systems, Operating Systems</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-3">Education</h2>
        <div class="bg-surface/40 border border-white/10 rounded-xl p-6 space-y-4 text-sm leading-relaxed text-white/80">
          <div>
            <div class="flex flex-wrap justify-between gap-2">
              <p class="text-white font-semibold">University of Washington, Seattle</p>
              <p>Expected June 2027</p>
            </div>
            <p>B.S. Computer Science & B.S. Mathematics • Paul G. Allen School • GPA 3.85/4.0</p>
          </div>
          <div class="pt-3 border-t border-white/10">
            <div class="flex flex-wrap justify-between gap-2">
              <p class="text-white font-semibold">Euler Circle (Advanced Math Institute)</p>
              <p>2024 — 2025</p>
            </div>
            <p>Advanced coursework in Nonstandard Analysis, Cryptography, Combinatorial Game Theory, and Complex Analysis.</p>
            <div class="flex flex-wrap gap-3 mt-3 text-xs">
              <a href="https://github.com/jayadevgh/Mathematics/blob/main/Nonstandard-Analysis-Math-Paper.pdf" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full border border-white/10 hover:border-accent text-white/80">Ramsey Theory paper →</a>
              <a href="https://github.com/jayadevgh/Mathematics/blob/main/EllipticCurves-CongNumer-Math-Paper.pdf" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full border border-white/10 hover:border-accent text-white/80">Elliptic Curve paper →</a>
              <a href="https://github.com/jayadevgh/Mathematics/blob/main/Combinatorial_Error_Correcting_Codes.pdf" target="_blank" rel="noopener noreferrer" class="px-3 py-1 rounded-full border border-white/10 hover:border-accent text-white/80">Coding Theory paper →</a>
            </div>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-3">Honors & Leadership</h2>
        <ul class="space-y-3 text-white/80 text-sm leading-relaxed">
          <li>
            2026 Hack to the Future — 1st Place Track Winner (<a href="https://devpost.com/software/keystroke-id" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent/80">KeyGuard →</a>)
          </li>
          <li>
            2025 DubHacks — Top 3 Winner, AWS Track (<a href="https://devpost.com/software/bond-xuhodw" target="_blank" rel="noopener noreferrer" class="text-accent underline hover:text-accent/80">Bond →</a>)
          </li>
          <li>
            USACO Gold Division — 2026
          </li>
          <li>
            AIME Qualifier (Top 5%) — 2022 & 2023
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-3">Experience</h2>
        <div class="space-y-5 text-white/80 text-sm leading-relaxed">
          <div class="bg-surface/40 border border-white/10 rounded-xl p-4">
            <div class="flex flex-wrap justify-between text-white font-semibold">
              <p>University of Washington — Noah’s ARK (UW NLP)</p>
              <p class="text-white/60 font-normal">2025 — Present</p>
            </div>
            <p>Undergraduate researcher building the multimodal music-understanding pipeline that links 1,000+ annotated scores with 1M+ performances and validates 200K+ YouTube recordings using DTW, audio embeddings, and transcription models.</p>
          </div>
          <div class="bg-surface/40 border border-white/10 rounded-xl p-4">
            <div class="flex flex-wrap justify-between text-white font-semibold">
              <p>Dartmouth-Hitchcock Medical Center — Levy Lab</p>
              <p class="text-white/60 font-normal">Summers 2023 — 2024</p>
            </div>
            <p>Research intern replacing destructive staining with GAN+GNN pipelines over 4,000+ images and shipping interpretable MIL workflows that reached 0.91 AUC on bladder cancer detection.</p>
          </div>
          <div class="bg-surface/40 border border-white/10 rounded-xl p-4">
            <div class="flex flex-wrap justify-between text-white font-semibold">
              <p>Independent Research — Harvard (Dr. Akshay Jagadeesh)</p>
              <p class="text-white/60 font-normal">2023 — 2024</p>
            </div>
            <p>Modeled continuous Alzheimer’s progression under data scarcity by training conditional + Wasserstein GANs that generated 5,000+ synthetic MRIs for downstream classification.</p>
          </div>
          <div class="bg-surface/40 border border-white/10 rounded-xl p-4">
            <div class="flex flex-wrap justify-between text-white font-semibold">
              <p>Teaching Assistant — Calculus</p>
              <p class="text-white/60 font-normal">2024 — 2025</p>
            </div>
            <p>Supported instruction by creating 10+ study guides, grading assignments, and mentoring 100+ students through office hours and exam prep.</p>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold mb-3">Key Project — KeyGuard (Feb 2026)</h2>
        <div class="bg-surface/40 border border-white/10 rounded-xl p-6 text-white/80 text-sm leading-relaxed space-y-4">
          <p class="text-white/90 font-semibold">Behavioral Identity Firewall • Hack to the Future 1st Place Track Winner</p>
          <p>
            KeyGuard keeps identity continuous instead of a one-time checkpoint by running a local keystroke-intelligence layer that locks sessions the moment another person starts typing.
          </p>
          <ul class="space-y-2">
            <li>• Instrumented the entire on-device pipeline (keystroke capture → dwell/flight/digraph features → five-second sliding windows → neural embedding) with zero raw content stored.</li>
            <li>• Trained a shared embedding model that L2-normalizes behavioral vectors and compares them against encrypted enrollment embeddings to spot impostors within ~15 seconds.</li>
            <li>• Built a policy engine that requires three consecutive anomalous windows before triggering Touch ID/PIN step-up auth, cutting false positives while catching real takeovers fast.</li>
            <li>• Packaged the system as a silent desktop agent with a deployment roadmap for JAMF/Intune and SDK hooks so security teams can add continuous verification without user friction.</li>
          </ul>
          <p class="text-white/70 text-xs">Stack: Python, PyTorch embedding model, real-time feature extraction, similarity scoring engine, Touch ID integration, encrypted local identity store</p>
          <div>
            <a href="https://github.com/jayadevgh/KeyStroke-ID" target="_blank" rel="noopener noreferrer" class="text-accent underline text-xs hover:text-accent/80">GitHub →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12 mb-12">
      <h2 class="text-2xl font-semibold mb-4">Photo Gallery</h2>
      <div class="relative overflow-hidden rounded-2xl shadow-2xl">
        <div id="carousel" class="flex transition-transform duration-500 ease-in-out">
          <img 
            src={JayGoldenGate.src}
            alt="Golden Gate Bridge"
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={WFSuitFriends.src}
            alt="With friends" 
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={SuitAura2.src}
            alt="Portrait" 
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={AuraPic.src}
            alt="Portrait"
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={WaterPolo.src}
            alt="Water polo"
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={CoastalHonorChoir.src}
            alt="Coastal Honor Choir performance"
            class="min-w-full h-[550px] object-cover" 
          />
          <img 
            src={PromFriends.src}
            alt="Prom with friends"
            class="min-w-full h-[550px] object-cover" 
          />
        </div>
        
        <button 
          id="prevBtn"
          class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full transition-all"
          aria-label="Previous image"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        
        <button 
          id="nextBtn"
          class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full transition-all"
          aria-label="Next image"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>

        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="0"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="1"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="2"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="3"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="4"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="5"></button>
          <button class="carousel-dot w-2 h-2 rounded-full bg-white/50 hover:bg-white transition-all" data-index="6"></button>
        </div>
      </div>
    </section>
  </section>

  <script>
    let currentIndex = 0;
    const carousel = document.getElementById('carousel');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const dots = document.querySelectorAll('.carousel-dot');
    const totalImages = 7;

    function updateCarousel() {
      carousel.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.add('bg-white');
          dot.classList.remove('bg-white/50');
        } else {
          dot.classList.remove('bg-white');
          dot.classList.add('bg-white/50');
        }
      });
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % totalImages;
      updateCarousel();
    }

    function prevImage() {
      currentIndex = (currentIndex - 1 + totalImages) % totalImages;
      updateCarousel();
    }

    nextBtn.addEventListener('click', nextImage);
    prevBtn.addEventListener('click', prevImage);

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        updateCarousel();
      });
    });

    // Auto-play (optional - uncomment if desired)
    // setInterval(nextImage, 5000);

    // Initialize
    updateCarousel();
  </script>
</BaseLayout>
